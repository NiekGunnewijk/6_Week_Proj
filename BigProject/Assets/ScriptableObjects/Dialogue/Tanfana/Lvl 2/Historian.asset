  m_Script: {fileID: 11500000, guid: 0f2eb0c4a1834594b9eb986c81e878ac, type: 3}
  m_Name: Historian
  m_EditorClassIdentifier: Assembly-CSharp::DialogueNode
  id: 
  currentLine: 3
  lines:
  - character: Player
    text: "Excuse me, I\u2019m looking for information about a stone"
  - character: Player
    text: " that was connected to Tanfana\u2019s sacred place."
  - character: Historian
    text: 'You mean the stone in the centre of the village? '
  - character: Historian
    text: Most people walk past it every day without thinking about it.
  - character: Player
    text: "That\u2019s the same stone?"
  - character: Historian
    text: 'People believed it had fallen from the heavens. '
  - character: Historian
    text: Some claimed it brought visions,
  - character: Historian
    text: others said they could hear voices when standing near it.
  - character: Player
    text: Is there any proof of that?
  - character: Historian
    text: 'Proof? No. Records? Maybe. '
  - character: Historian
    text: 'We keep some old documents in the village archives. '
  - character: Historian
    text: If you want to know more, you should start there.
